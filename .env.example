# ============================================================
# AlphaDesk configuration
# Copy this file to .env and edit. Every value has a safe default:
# with no .env at all, AlphaDesk runs fully offline in Demo mode.
# ============================================================

# ---- Server ----
ALPHADESK_HOST=127.0.0.1
ALPHADESK_PORT=8742

# ---- Log file (always-on rotating sink) ----
# Every launch writes data/logs/app.log so sessions leave a forensic trail
# even when console output is not redirected. 0 disables; any path relocates.
# ALPHADESK_FILE_LOG=1
# ALPHADESK_LOG_FILE=data/logs/app.log

# ---- Trading mode: demo | paper | live ----
# demo  = synthetic offline market, built-in paper broker (zero setup)
# paper = real market data, simulated fills (Alpaca paper or built-in sim)
# live  = real money through a broker. Requires ENABLE_LIVE_TRADING=true.
ALPHADESK_MODE=demo

# ---- Data provider: auto | synthetic | yahoo | alpaca ----
# auto picks: alpaca if keys are set, else yahoo, else synthetic.
DATA_PROVIDER=auto

# ---- Broker: paper_sim | alpaca ----
# paper_sim is the built-in local fill simulator (demo/paper modes).
BROKER=paper_sim

# ---- Alpaca (https://alpaca.markets - free paper trading keys) ----
ALPACA_API_KEY=
ALPACA_API_SECRET=
# true = Alpaca paper endpoint, false = Alpaca live endpoint
ALPACA_PAPER=true

# ---- Live trading hard gate ----
# Both this flag AND a typed confirmation in the UI are required
# before any live order can be submitted.
ENABLE_LIVE_TRADING=false

# ---- Risk defaults (editable at runtime in Settings UI) ----
RISK_PER_TRADE_PCT=0.5
MAX_POSITION_PCT=20
MAX_OPEN_POSITIONS=4
MAX_DAILY_LOSS_PCT=2.0
MAX_DRAWDOWN_PCT=10.0
ENABLE_MAX_DRAWDOWN_HALT=true
CONSECUTIVE_LOSS_LIMIT=3
COOLDOWN_MINUTES=30
NO_ENTRY_MINUTES_BEFORE_CLOSE=30
FLATTEN_MINUTES_BEFORE_CLOSE=5

# ---- Paper simulator ----
PAPER_STARTING_CASH=100000
PAPER_SLIPPAGE_BPS=2
PAPER_COMMISSION_PER_SHARE=0.0
PAPER_MINIMUM_COMMISSION=0.0

# ---- Opportunity economics ----
OPPORTUNITY_ENABLED=true
OPPORTUNITY_MIN_NET_EDGE_BPS=15
OPPORTUNITY_MIN_REWARD_RISK=1.25
OPPORTUNITY_ROUND_TRIP_COST_BPS=8

# Overnight research is disabled until independently validated.
OVERNIGHT_ENABLED=false
OVERNIGHT_MAX_ALLOCATION_PCT=15

# ---- Engine ----
POLL_INTERVAL_SEC=5
DEMO_BAR_SECONDS=5
DEFAULT_WATCHLIST=SPY,QQQ,AAPL,NVDA,TSLA,MSFT,AMD,META

# ---- AI ----
ML_CONFIDENCE_THRESHOLD=0.55
ML_HORIZON_BARS=15
# Optional: polish AI insights with Gemini or Claude. Fully optional; never required.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# --- Behavioral loop detector ---
# Max 24h traded notional as a multiple of equity before the churn breaker blocks entries.
MAX_DAILY_TURNOVER_MULTIPLE=2.0

# --- ML promotion gate ---
# Absolute minimum validation AUC for promoting global signal models.
ML_MIN_PROMOTABLE_AUC=0.53

# --- End-of-day safety ---
# Minutes past session close during which an initiated EOD flatten keeps retrying
# until the broker proves flat (protects against broker outages at the close).
EOD_POST_CLOSE_GRACE_MINUTES=15
